entry {
    placeholder: "";
    /* Màu chữ sáng, tinh khiết */
    text-color: #f0f0f0;
    padding: 8px 0 8px 8px;
    /* Nền hoàn toàn trong suốt hoặc mờ nhẹ */
    background-color: rgba(255, 255, 255, 0%);
}

configuration {
    font: "JetBrainsMono Nerd Font Mono 12";
    lines: 10;
    fixed-num-lines: true;
    padding: 10px;
}

inputbar {
    children: [entry];
}

* {
    separatorcolor: transparent;
    /* Hiệu ứng mờ nhẹ khi chọn, trông giống như thủy tinh được chạm vào */
    selected-normal-background: rgba(255, 255, 255, 15%);
    normal-background: rgba(255, 255, 255, 0%);
    alternate-normal-background: rgba(255, 255, 255, 0%);
}

mainbox {
    /* Viền mỏng, sáng để làm nổi bật "lớp thủy tinh" */
    border: 1px;
    border-color: rgba(255, 255, 255, 40%);
    /* Bo tròn lớn hơn */
    border-radius: 15px;
    padding: 10px;
}

window {
    /* Bo tròn lớn hơn cho cửa sổ */
    border-radius: 18px;
    /* Viền mỏng */
    border: 1px solid;
    border-color: rgba(255, 255, 255, 10%);
    /* Nền tối nhẹ nhàng với độ trong suốt cao (Liquid Glass Effect) */
    background-color: rgba(38, 43, 52, 70%); /* Giảm độ mờ một chút so với bản gốc */
    padding: 0px;
    width: 30%;
}


listview {
    lines: 10;
}

element {
    padding: 10px 10px;
    height: 50px;
    /* Bo tròn tinh tế hơn cho các phần tử */
    border-radius: 10px;
    children: [ element-text, element-icon ];
}

element-text {
    /* Màu chữ sáng, rõ ràng trên nền mờ */
    text-color: #ffffff;
}

#scrollbar {
    /* Thanh cuộn tối hơn một chút nhưng vẫn trong suốt */
    handle-color: rgba(255, 255, 255, 30%);
    handle-width: 4px ;
    padding: 0;
}


